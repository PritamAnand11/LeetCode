class Solution {
    public List<Integer> partitionLabels(String s) {
        List<Integer> result = new ArrayList<>();
        int[] last = new int[26];
        
        for (int i = 0; i < s.length(); i++) {
            last[s.charAt(i) - 'a'] = i;
        }
        int start = 0;
        int max = 0;
        
        for (int i = 0; i < s.length(); i++) {
            max = Math.max(max, last[s.charAt(i) - 'a']);
            if (max == i) {
                result.add(max - start + 1);
                start = max + 1;
            }
        }
        return result;
    }
}
