class Solution {
    public long minSumSquareDiff(int[] nums1, int[] nums2, int k1, int k2) {
        int n = nums1.length;
        int[] counts = new int[100001];
        long totalDiff = 0;
        int maxDiff = 0;
        
        for (int i = 0; i < n; i++) {
            int diff = Math.abs(nums1[i] - nums2[i]);
            if (diff > 0) {
                counts[diff]++;
                totalDiff += diff;
                maxDiff = Math.max(maxDiff, diff);
            }
        }
        long k = (long) k1 + k2;
        if (totalDiff <= k) {
            return 0;
        }
        for (int i = maxDiff; i > 0 && k > 0; i--) {
            if (counts[i] > 0) {
                long take = Math.min((long) counts[i], k);
                counts[i] -= take;
                counts[i - 1] += take;
                k -= take;
                
                if (counts[i] > 0) {
                    break;
                }
            }
        }
        long ans = 0;
        for (int i = 1; i <= maxDiff; i++) {
            if (counts[i] > 0) {
                ans += (long) i * i * counts[i];
            }
        }
        return ans;
    }
}
