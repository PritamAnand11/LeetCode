import java.util.HashMap;
import java.util.Map;

class Solution {
    public long maxArea(int[][] coords) {
        long ans = calc(coords);
        for (int[] c : coords) {
            int tmp = c[0];
            c[0] = c[1];
            c[1] = tmp;
        }
        ans = Math.max(ans, Math.max(ans, calc(coords)));
        return ans > 0 ? ans : -1;
    }

    private long calc(int[][] coords) {
        int mn = Integer.MAX_VALUE;
        int mx = Integer.MIN_VALUE;
        Map<Integer, Integer> f = new HashMap<>();
        Map<Integer, Integer> g = new HashMap<>();
        for (int[] c : coords) {
            int x = c[0];
            int y = c[1];
            mn = Math.min(mn, x);
            mx = Math.max(mx, x);
            if (f.containsKey(x)) {
                f.put(x, Math.min(f.get(x), y));
                g.put(x, Math.max(g.get(x), y));
            } else {
                f.put(x, y);
                g.put(x, y);
            }
        }
        long ans = 0;
        for (Map.Entry<Integer, Integer> entry : f.entrySet()) {
            int x = entry.getKey();
            int y = entry.getValue();
            long d = g.get(x) - y;
            ans = Math.max(ans, d * Math.max(mx - x, x - mn));
        }
        return ans;
    }
}
