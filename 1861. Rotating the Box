class Solution {
    public char[][] rotateTheBox(char[][] box) {
        int m = box.length;
        int n = box[0].length;
        char[][] ans = new char[n][m];
        
        for (int i = 0; i < n; i++) {
            for (int j = 0; j < m; j++) {
                ans[i][j] = '.';
            }
        }
        for (int i = 0; i < m; ++i) {
            for (int j = n - 1, k = n - 1; j >= 0; --j) {
                if (box[i][j] != '.') {
                    if (box[i][j] == '*') {
                        k = j;
                    }
                    ans[k--][m - i - 1] = box[i][j];
                }
            }
        }
        return ans;
    }
}
