import java.util.Arrays;

class Solution {
    public int findTheDistanceValue(int[] arr1, int[] arr2, int d) {
        Arrays.sort(arr2);
        int count = 0;

        for (int num : arr1) {
            int index = Arrays.binarySearch(arr2, num - d);
            if (index < 0) {
                index = -index - 1;
            }
            if (index == arr2.length || arr2[index] > num + d) {
                count++;
            }
        }
        return count;
    }
}
