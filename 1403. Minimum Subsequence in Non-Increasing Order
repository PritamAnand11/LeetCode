import java.util.*;

class Solution {
    public List<Integer> minSubsequence(int[] nums) {
        Arrays.sort(nums);
        int totalSum = 0;
        for (int num : nums) {
            totalSum += num;
        }
        
        List<Integer> result = new ArrayList<>();
        int subsequenceSum = 0;
        
        for (int i = nums.length - 1; i >= 0; i--) {
            subsequenceSum += nums[i];
            result.add(nums[i]);
            if (subsequenceSum > totalSum - subsequenceSum) {
                break;
            }
        }
        return result;
    }
}
