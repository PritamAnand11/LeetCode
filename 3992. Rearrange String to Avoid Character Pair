class Solution {
    public String rearrangeString(String s, char x, char y) {
        StringBuilder sbY = new StringBuilder();
        StringBuilder sbOther = new StringBuilder();
        
        for (int i = 0; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == y) {
                sbY.append(c);
            } else {
                sbOther.append(c);
            }
        }
        return sbY.append(sbOther).toString();
    }
}
