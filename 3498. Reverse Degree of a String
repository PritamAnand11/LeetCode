class Solution {
    public int reverseDegree(String s) {
        int totalSum = 0;
        for (int i = 0; i < s.length(); i++) {
            int reverseAlphabetPosition = 'z' - s.charAt(i) + 1;
            int stringPosition = i + 1;
            totalSum += reverseAlphabetPosition * stringPosition;
        }
        return totalSum;
    }
}
